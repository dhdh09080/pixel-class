{
  "name": "pixel-class",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "tsc -b && vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc -b",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "npm run build && playwright test",
    "setup:private": "node scripts/setup-private.mjs",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test:operations": "node scripts/test-operations.mjs",
    "db:backup": "node scripts/database.mjs backup",
    "db:restore": "node scripts/database.mjs restore",
    "db:verify": "node scripts/database.mjs verify",
    "test:soak": "npm run build && node scripts/soak.mjs",
    "design:capture": "node scripts/capture-design.mjs",
    "test:load": "node scripts/load-realtime.mjs",
    "deploy:check": "node --import tsx scripts/check-deployment.mjs"
  },
  "dependencies": {
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "tsx": "4.23.15",
    "ws": "8.22.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.5.15",
    "@playwright/test": "1.65.0",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.2.1",
    "concurrently": "10.0.6",
    "lucide-react": "1.70.0",
    "phaser": "4.2.1",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  }
}
