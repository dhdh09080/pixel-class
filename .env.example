# 로컬 체험 모드. production에서는 항상 비활성화됩니다.
DEMO_MODE=true

# 비워 두면 데모: data/demo.sqlite, 비공개: data/school.sqlite
DATABASE_PATH=
HOST=127.0.0.1
PORT=3001

# 최초 MASTER 등록에만 사용. 실제 값은 .env / 서버 비밀 환경 변수에 보관하세요.
MASTER_BOOTSTRAP_KEY=

# HTTPS 역방향 프록시로 운영할 때 true로 설정
COOKIE_SECURE=false
# 예: https://class.example.com (경로 없이 정확한 출처)
PUBLIC_ORIGIN=

# 브라우저로 보내지 않는 서버 전용 값. 미설정 시 AI 버튼은 비활성화됩니다.
OPENAI_API_KEY=
# 계정에서 사용할 수 있는 Responses API 지원 모델 ID를 지정하세요.
OPENAI_MODEL=

# 개발/테스트 포트를 바꿀 때만 필요합니다.
API_PORT=3001
VITE_PORT=5173

# Playwright 실행 파일 (이 Cloud 환경의 Chromium)
CHROMIUM_PATH=/usr/bin/chromium

# Compose 배포 준비용. 실제 배포/인증서 발급은 별도 검증이 필요합니다.
# PIXEL_DOMAIN=class.example.com
# DATABASE_URL= (Supabase 검증용 psql 환경 변수, 앱 연결 변수가 아님)

# 프로덕션에서 Caddy 한 홉 뒤에 있을 때만 1. 앱 포트 외부 노출 금지.
TRUST_PROXY_HOPS=0
# 루프백 HTTP 자동 테스트 전용. 실제 배포에서는 설정하지 않습니다.
ALLOW_INSECURE_LOCALHOST=false
# 선택: 서버 전용 Docker secret 파일. 직접 값과 동시에 설정하지 않습니다.
# MASTER_BOOTSTRAP_KEY_FILE=/run/secrets/master_bootstrap
# OPENAI_API_KEY_FILE=/run/secrets/openai_api_key

# SQLite에 보존하는 학교 전체 UTC 일일 호출 상한. 기본 60, 최초 실연결 평가에는 3 권장.
AI_SCHOOL_DAILY_CALLS=60
# 단일 앱 전체의 동시 AI 호출 수. 기본 2. 달러 예산은 제공자에서 별도 설정.
AI_MAX_CONCURRENT=2
