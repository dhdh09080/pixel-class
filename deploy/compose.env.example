# Copy OUTSIDE the repository, chmod 600, replace every example value.
PIXEL_DOMAIN=class-test.example.com
# Registry digest or a locally built immutable image ID. Never use a floating tag.
PIXEL_IMAGE=registry.example.com/pixel-class@sha256:REPLACE_WITH_VERIFIED_DIGEST
# 127.0.0.1 cannot be reached by students on another computer.
# Prefer your VPN interface IP; 0.0.0.0 requires firewall rules and the staging gate.
PIXEL_BIND=127.0.0.1
PIXEL_HTTP_PORT=80
PIXEL_HTTPS_PORT=443
MASTER_BOOTSTRAP_FILE=/srv/pixel-private/master-bootstrap
STAGING_ACCESS_FILE=/srv/pixel-private/staging-access.caddy
# Optional: use deploy/compose.ai.yaml, a restricted project key and provider budget.
# OPENAI_API_KEY_FILE=/srv/pixel-private/openai-api-key
# OPENAI_MODEL=MODEL_AVAILABLE_TO_YOUR_PROJECT
# Start with a small school-wide call cap for the first real-model evaluation.
AI_SCHOOL_DAILY_CALLS=3
AI_MAX_CONCURRENT=1
